<.header>
  {@page_title}
  <:actions>
    <.link navigate={~p"/clubs/#{@club}/accountclasses"}>
      <.button>Kontenklasen</.button>
    </.link>
  </:actions>
  <:actions>
    <.link navigate={~p"/clubs/#{@club}/accountgroups"}>
      <.button>Kontengruppen</.button>
    </.link>
  </:actions>
  <:actions>
    <.link navigate={~p"/clubs/#{@club}/accounts/new"}>
      <.button>Konto erstellen</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <%= if @has_accounts? do %>
    <.table
      id="accounts"
      rows={@streams.accounts}
      row_click={fn {_id, account} -> JS.navigate(~p"/accounts/#{account}") end}
    >
      <:col :let={{_id, account}} label="Kontonummer">
        {format_string_field(account.accountnumber)}
      </:col>
      <:col :let={{_id, account}} label="Kontobezeichnung">
        {format_string_field(account.accountname)}
      </:col>
      <:action :let={{_id, account}}>
        <.link navigate={~p"/accounts/#{account}"}>Anzeigen</.link>
      </:action>
    </.table>
  <% else %>
    <p>
      Bisher wurde noch keine Konten erstellt.<br />
    </p>
  <% end %>
</.card>
