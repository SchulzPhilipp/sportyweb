<.header>
  Accountgroup {@accountgroup.id}
  <:subtitle>This is a accountgroup record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/accountgroups/#{@accountgroup}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit accountgroup</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Accountgroupname">{@accountgroup.accountgroupname}</:item>
</.list>

<.back navigate={~p"/accountgroups"}>Back to accountgroups</.back>

<.modal
  :if={@live_action == :edit}
  id="accountgroup-modal"
  show
  on_cancel={JS.patch(~p"/accountgroups/#{@accountgroup}")}
>
  <.live_component
    module={SportywebWeb.AccountgroupLive.FormComponent}
    id={@accountgroup.id}
    title={@page_title}
    action={@live_action}
    accountgroup={@accountgroup}
    patch={~p"/accountgroups/#{@accountgroup}"}
  />
</.modal>
