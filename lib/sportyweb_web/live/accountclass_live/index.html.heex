<.header>
  {@page_title}
  <:actions>
    <.link navigate={~p"/clubs/#{@club}/accountclasses/new"}>
      <.button>Kontenklasse erstellen</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <%= if @has_accountclasses? do %>
    <.table
      id="accountclasses"
      rows={@streams.accountclasses}
      row_click={fn {_id, accountclass} -> JS.navigate(~p"/accountclasses/#{accountclass}") end}
    >
      <:col :let={{_id, accountclass}} label="Nummer">
        {accountclass.accountclassnumber}
      </:col>
      <:col :let={{_id, accountclass}} label="Bezeichnung">{accountclass.accountclassname}</:col>
      <:action :let={{_id, accountclass}}>
          <.link navigate={~p"/accountclasses/#{accountclass}"}>Anzeigen</.link>
      </:action>
    </.table>
  <% else %>
    <p>
      Bisher wurde noch keine Kontenklassen erstellt.<br />
    </p>
  <% end %>
</.card>
<.back navigate={~p"/clubs/#{@club}/accounts"}>
  Zurück zum Kontenplan
</.back>
